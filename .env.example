# Postgres (Supabase)
DATABASE_URL=
DIRECT_URL=

# Contact form email (Resend: https://resend.com/api-keys)
RESEND_API_KEY=
# Inbox that receives contact form messages
CONTACT_TO_EMAIL=
# Optional sender. Leave empty to use onboarding@resend.dev, which only
# delivers to your Resend account email until you verify a domain.
CONTACT_FROM_EMAIL=

# Supabase project URL (public) — product photos are served from its Storage
NEXT_PUBLIC_SUPABASE_URL=
# Secret admin key, only used by `npm run images:upload`. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
